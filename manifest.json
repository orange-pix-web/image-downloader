{
  "manifest_version": 3,
  "name": "AI 商品图工作台",
  "version": "7.10.0",
  "description": "支持 ChatGPT 两阶段提示词与生图工作流、Obsidian Vault 同步及图片批量下载。",
  "permissions": ["downloads", "activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://grok.com/*",
    "https://www.grok.com/*",
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.doubao.com/*",
    "https://*.doubaocdn.com/*",
    "https://*.byteimg.com/*"
  ],
  "action": {
    "default_title": "AI 图片顺序下载器",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://grok.com/*", "https://www.grok.com/*"],
      "js": ["grok.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://www.doubao.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "dashboard.css", "dashboard.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://www.doubao.com/*"
      ]
    }
  ]
}
