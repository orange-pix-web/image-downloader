{
  "manifest_version": 3,
  "name": "AI 图片顺序下载器",
  "version": "6.5.2",
  "description": "支持对话生成图与 ChatGPT 资料库图片的单张、批量、按时间下载和删除。",
  "permissions": ["downloads", "activeTab", "storage", "tabs"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://www.doubao.com/*",
    "https://*.doubaocdn.com/*",
    "https://*.byteimg.com/*"
  ],
  "action": {
    "default_title": "AI 图片顺序下载器",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://www.doubao.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "dashboard.css", "dashboard.js"],
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://www.doubao.com/*"
      ]
    }
  ]
}
